{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RideLedger (Debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": [
        "--dart-define=ENV=debug"
      ]
    },
    {
      "name": "RideLedger (Profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "args": [
        "--dart-define=ENV=profile"
      ]
    },
    {
      "name": "RideLedger (Release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": [
        "--dart-define=ENV=release"
      ]
    },
    {
      "name": "RideLedger (Web - Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "debug"
    },
    {
      "name": "Attach to Device",
      "request": "attach",
      "type": "dart"
    }
  ]
}
