RoutePointModel _$RoutePointModelFromJson(Map<String, dynamic> json) =>
    RoutePointModel()
      ..id = (json['id'] as num?)?.toInt()
      ..pointId = json['pointId'] as String
      ..sessionId = json['sessionId'] as String
      ..timestamp = DateTime.parse(json['timestamp'] as String)
      ..latitude = (json['latitude'] as num).toDouble()
      ..longitude = (json['longitude'] as num).toDouble()
      ..speedKmh = (json['speedKmh'] as num).toDouble()
      ..accuracyM = (json['accuracyM'] as num?)?.toDouble()
      ..altitudeM = (json['altitudeM'] as num?)?.toDouble();

Map<String, dynamic> _$RoutePointModelToJson(RoutePointModel instance) =>
    <String, dynamic>{
      'id': instance.id,
      'pointId': instance.pointId,
      'sessionId': instance.sessionId,
      'timestamp': instance.timestamp.toIso8601String(),
      'latitude': instance.latitude,
      'longitude': instance.longitude,
      'speedKmh': instance.speedKmh,
      'accuracyM': instance.accuracyM,
      'altitudeM': instance.altitudeM,
    };
