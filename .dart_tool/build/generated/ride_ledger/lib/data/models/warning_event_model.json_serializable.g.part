WarningEventModel _$WarningEventModelFromJson(Map<String, dynamic> json) =>
    WarningEventModel()
      ..id = (json['id'] as num?)?.toInt()
      ..warningId = json['warningId'] as String
      ..sessionId = json['sessionId'] as String
      ..timestamp = DateTime.parse(json['timestamp'] as String)
      ..type = json['type'] as String
      ..message = json['message'] as String
      ..speedKmh = (json['speedKmh'] as num?)?.toDouble()
      ..breakInStageName = json['breakInStageName'] as String?;

Map<String, dynamic> _$WarningEventModelToJson(WarningEventModel instance) =>
    <String, dynamic>{
      'id': instance.id,
      'warningId': instance.warningId,
      'sessionId': instance.sessionId,
      'timestamp': instance.timestamp.toIso8601String(),
      'type': instance.type,
      'message': instance.message,
      'speedKmh': instance.speedKmh,
      'breakInStageName': instance.breakInStageName,
    };
