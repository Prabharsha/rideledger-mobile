RideSessionModel _$RideSessionModelFromJson(Map<String, dynamic> json) =>
    RideSessionModel()
      ..id = (json['id'] as num?)?.toInt()
      ..sessionId = json['sessionId'] as String
      ..date = DateTime.parse(json['date'] as String)
      ..startTime = DateTime.parse(json['startTime'] as String)
      ..endTime = DateTime.parse(json['endTime'] as String)
      ..startOdometerKm = (json['startOdometerKm'] as num).toDouble()
      ..endOdometerKm = (json['endOdometerKm'] as num).toDouble()
      ..distanceKm = (json['distanceKm'] as num).toDouble()
      ..durationSeconds = (json['durationSeconds'] as num).toInt()
      ..averageSpeedKmh = (json['averageSpeedKmh'] as num).toDouble()
      ..maxSpeedKmh = (json['maxSpeedKmh'] as num).toDouble()
      ..breakInStageName = json['breakInStageName'] as String
      ..overspeedEventCount = (json['overspeedEventCount'] as num).toInt()
      ..lowSpeedDurationSeconds =
          (json['lowSpeedDurationSeconds'] as num).toInt()
      ..stopDurationSeconds = (json['stopDurationSeconds'] as num).toInt()
      ..trafficStressLevel = json['trafficStressLevel'] as String
      ..estimatedFuelUsedLiters =
          (json['estimatedFuelUsedLiters'] as num).toDouble()
      ..fuelEconomyUsedKmPerLiter =
          (json['fuelEconomyUsedKmPerLiter'] as num).toDouble()
      ..rideType = json['rideType'] as String
      ..encodedRoutePolyline = json['encodedRoutePolyline'] as String?
      ..notes = json['notes'] as String?
      ..createdAt = DateTime.parse(json['createdAt'] as String)
      ..updatedAt = DateTime.parse(json['updatedAt'] as String);

Map<String, dynamic> _$RideSessionModelToJson(RideSessionModel instance) =>
    <String, dynamic>{
      'id': instance.id,
      'sessionId': instance.sessionId,
      'date': instance.date.toIso8601String(),
      'startTime': instance.startTime.toIso8601String(),
      'endTime': instance.endTime.toIso8601String(),
      'startOdometerKm': instance.startOdometerKm,
      'endOdometerKm': instance.endOdometerKm,
      'distanceKm': instance.distanceKm,
      'durationSeconds': instance.durationSeconds,
      'averageSpeedKmh': instance.averageSpeedKmh,
      'maxSpeedKmh': instance.maxSpeedKmh,
      'breakInStageName': instance.breakInStageName,
      'overspeedEventCount': instance.overspeedEventCount,
      'lowSpeedDurationSeconds': instance.lowSpeedDurationSeconds,
      'stopDurationSeconds': instance.stopDurationSeconds,
      'trafficStressLevel': instance.trafficStressLevel,
      'estimatedFuelUsedLiters': instance.estimatedFuelUsedLiters,
      'fuelEconomyUsedKmPerLiter': instance.fuelEconomyUsedKmPerLiter,
      'rideType': instance.rideType,
      'encodedRoutePolyline': instance.encodedRoutePolyline,
      'notes': instance.notes,
      'createdAt': instance.createdAt.toIso8601String(),
      'updatedAt': instance.updatedAt.toIso8601String(),
    };
